# Copy to .env (gitignored, chmod 600) and fill in. A variable set in the shell wins over this file.
# Plain KEY=VALUE lines: no inline comments; an empty value counts as unset. docs/ has values for known clusters.

# Required. Weights (Hugging Face cache), run records (runs/) and endpoint files (endpoints/). A folder on fast
# storage that every node mounts, since server and client jobs meet there. $USER and ~ are expanded.
# plyserve sets HF_HOME to $PLYSERVE_HOME/hf itself.
PLYSERVE_HOME=

# Optional. A fixed API key for every server. Unset: each run makes a new one, which clients in the same job
# get from plyserve and clients in other jobs from the endpoint file. Set it when a client outside the cluster
# (through a tunnel) needs a key that stays the same. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PLYSERVE_API_KEY=

# Optional, for `serve --expose`. The address vLLM listens on (default 0.0.0.0, every interface) and the host
# name the endpoint file gives clients (default: the node's host name). Set them when the nodes reach each
# other only on one network, e.g. PLYSERVE_EXPOSE_HOST=$(hostname)-ib. Only for IPv4.
PLYSERVE_EXPOSE_BIND=
PLYSERVE_EXPOSE_HOST=

# Optional. Higher Hugging Face rate limits; the models are public, so a read-only token is enough.
HF_TOKEN=

# Optional. Lets hf_xet use more connections and CPU when downloading.
HF_XET_HIGH_PERFORMANCE=1
