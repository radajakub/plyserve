# Copy to .env (gitignored) and fill in. A variable set in the shell wins over this file.
# Plain KEY=VALUE lines: no inline comments; an empty value counts as unset.

# Required. Weights (Hugging Face cache), endpoint files and the API key; a folder on fast storage.
# $USER and ~ are expanded. plyserve sets HF_HOME to $PLYSERVE_HOME/hf itself.
PLYSERVE_HOME=/mnt/personal/$USER/plyserve-home

# Optional. Higher Hugging Face rate limits; the models are public, so a read-only token is enough.
HF_TOKEN=

# Optional. Lets hf_xet use more connections and CPU when downloading.
HF_XET_HIGH_PERFORMANCE=1
